# Environment Configuration for SereneSpace Backend
# Copy this file to .env and fill in your actual values

# ============================================
# OpenAI API Configuration (REQUIRED)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# New accounts get $5 free credits (expires in 3 months)
# Pricing: GPT-3.5-turbo ~$0.002 per 1K tokens
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (OPTIONAL)
# Options: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview
# Default: gpt-3.5-turbo (recommended for cost/performance)
OPENAI_MODEL=gpt-3.5-turbo

# ============================================
# JWT Authentication Secret (REQUIRED)
# ============================================
# Generate a secure random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# ============================================
# Server Configuration (OPTIONAL)
# ============================================
# Port for Express server (default: 4000)
PORT=4000

# Node environment (development/production)
NODE_ENV=development

# ============================================
# Database Configuration (AUTO-CONFIGURED)
# ============================================
# Prisma uses the connection in schema.prisma
# SQLite is configured by default: file:./dev.db
# No additional environment variables needed for SQLite

# ============================================
# Advanced Settings (OPTIONAL)
# ============================================
# Enable debug logs (true/false)
DEBUG=false

# API timeout in milliseconds
API_TIMEOUT=30000

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. Never commit this file to version control
# 2. Add .env to your .gitignore file
# 3. Keep your API keys secure
# 4. Use different secrets for development and production
# 5. For production, use strong, randomly generated secrets
